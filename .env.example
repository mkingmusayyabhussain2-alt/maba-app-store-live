# MABA App Store — environment variables
# Copy to .env.local for local dev. NEVER commit real values.
# On Vercel: Project Settings -> Environment Variables -> add the same names.

# --- Supabase (https://supabase.com/dashboard -> your project -> Settings -> API) ---
# Project URL. Public — safe to expose, the anon key is also public by design.
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public key (starts with "eyJ..."). Used only for public reads, if any.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (starts with "eyJ..."). SECRET — server only, never in
# the browser, never in chat, never in git. All DB access uses this key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
# Random 32+ character secret used to sign the maba_verify cookie (HMAC).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
# The store owner's email (your Gmail). Only this email can open /api/admin/*.
OWNER_EMAIL=

# --- Email (Gmail SMTP, via nodemailer) ---
# No paid email service needed: mail goes out from the owner's own Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Owner's Gmail address (same as OWNER_EMAIL in most cases).
SMTP_USER=
# Gmail APP PASSWORD (16 characters, no spaces) — NOT your normal Google
# password. Create one at: Google Account -> Security -> 2-Step Verification
# (must be ON) -> App passwords -> generate one for "Mail". If you change your
# Google password, the App Password keeps working; revoke it any time from
# the same page. Never paste it in chat.
SMTP_PASS=
# What users see as the sender, e.g. "MABA App Store <owner@gmail.com>"
SMTP_FROM=
